<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="flashit"
        Arguments=""
        InstallLocation="C:\Program Files\Kyle Upton\FlashIt">
    </Installer>
    <PackageInformation
        PackageName="FlashIt"
        PackageDisplayName="FlashIt"
        PublisherName="CN=Kyle Upton"
        PublisherDisplayName="Kyle Upton"
        Version="0.1.0.0"
        PackageDescription="A program that helps you flash your USB drives">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wails.flashit"
                Description="A program that helps you flash your USB drives"
                DisplayName="FlashIt"
                ExecutableName="flashit"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>FlashIt</DisplayName>
            <PublisherDisplayName>Kyle Upton</PublisherDisplayName>
            <Description>A program that helps you flash your USB drives</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="flashit.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
