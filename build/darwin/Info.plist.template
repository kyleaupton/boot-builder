<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
            <string>APPL</string>
        <key>CFBundleName</key>
            <string>FlashIt</string>
        <key>CFBundleExecutable</key>
            <string>flashit</string>
        <key>CFBundleIdentifier</key>
            <string>dev.kyleupton.flashit</string>
        <key>CFBundleVersion</key>
            <string>${VERSION}</string>
        <key>CFBundleGetInfoString</key>
            <string>FlashIt - Create bootable USB installers</string>
        <key>CFBundleShortVersionString</key>
            <string>${VERSION}</string>
        <key>CFBundleIconFile</key>
            <string>icons</string>
        <key>LSMinimumSystemVersion</key>
            <string>10.15.0</string>
        <key>NSHighResolutionCapable</key>
            <string>true</string>
        <key>NSHumanReadableCopyright</key>
            <string>© now, My Company</string>
        <key>SMPrivilegedExecutables</key>
            <dict>
              <key>dev.kyleupton.flashit.helper</key>
              <string>identifier "dev.kyleupton.flashit.helper" and anchor apple generic and certificate leaf[subject.OU] = "${APPLE_TEAM_ID}"</string>
            </dict>
    </dict>
</plist>